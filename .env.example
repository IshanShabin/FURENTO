# Copy this file to .env and fill in the values. .env is git-ignored, so keep real secrets there.

# Password for the MySQL root user inside Docker (pick anything)
DB_PASSWORD=change-me

# Signing key for login tokens: at least 32 random characters.
# PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Bash:        openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Admin account created on first start (password at least 8 characters). Leave empty for none.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Optional: Razorpay test keys. Without them only cash on delivery is offered.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set to true only when the site is served over HTTPS
JWT_COOKIE_SECURE=false
